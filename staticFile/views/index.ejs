<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>Images</h1>

    <div>
    <% images.forEach((img)=>{ %>
        <img src="/static/<%= img %>" width="200px" height="200px"/>
    <% }) %>
    </div>

    <div>
        <% for(let i=1;i<= totalPages;i++){ %>
            <a href="/index?page=<%= i %>">
                <%= i %>
            </a>
        <% } %>
    </div>
</div>
</body>
</html>